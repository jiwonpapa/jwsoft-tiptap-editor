{
  "extension_point": "html_content",
  "mode": "replace",
  "components": [
    {
      "type": "composite",
      "name": "HtmlContent",
      "props": {
        "content": "{{extensionPointProps.content ?? ''}}",
        "isHtml": "{{extensionPointProps.isHtml ?? true}}",
        "className": "{{(extensionPointProps.className ?? '') + ' jwsoft-tiptap-content'}}",
        "purifyConfig": {
          "ALLOWED_TAGS": [
            "p",
            "br",
            "h2",
            "h3",
            "h4",
            "strong",
            "em",
            "u",
            "s",
            "blockquote",
            "ul",
            "ol",
            "li",
            "a",
            "pre",
            "code",
            "hr",
            "table",
            "thead",
            "tbody",
            "tr",
            "th",
            "td",
            "img",
            "figure",
            "figcaption"
          ],
          "ALLOWED_ATTR": [
            "alt",
            "class",
            "colspan",
            "dir",
            "height",
            "href",
            "lang",
            "loading",
            "rel",
            "rowspan",
            "scope",
            "src",
            "start",
            "target",
            "title",
            "width"
          ],
          "ALLOW_DATA_ATTR": false,
          "ALLOW_ARIA_ATTR": false,
          "FORBID_ATTR": ["id", "style"]
        }
      }
    },
    {
      "id": "jwsoft_tiptap_content_style_injector",
      "type": "basic",
      "name": "Div",
      "props": { "className": "hidden" },
      "lifecycle": {
        "onMount": [
          {
            "handler": "jwsoft-tiptap-editor.injectContentStyles",
            "params": {
              "externalMediaLoadMode": "{{_global.plugins['jwsoft-tiptap-editor']?.externalMediaLoadMode ?? 'click'}}",
              "mediaAutoplay": "{{_global.plugins['jwsoft-tiptap-editor']?.mediaAutoplay ?? false}}"
            }
          }
        ]
      }
    }
  ],
  "priority": 100
}
