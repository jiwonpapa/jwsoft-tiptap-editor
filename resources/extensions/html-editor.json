{
  "extension_point": "html_editor",
  "mode": "replace",
  "components": [
    {
      "id": "jwsoft_tiptap_editor_container",
      "type": "basic",
      "name": "Div",
      "props": {
        "id": "jwsoft-tiptap-{{extensionPointProps.name ?? 'content'}}",
        "className": "jwsoft-tiptap-wrapper"
      },
      "lifecycle": {
        "onMount": [
          {
            "handler": "jwsoft-tiptap-editor.initEditor",
            "params": {
              "name": "{{extensionPointProps.name ?? 'content'}}",
              "content": "{{extensionPointProps.content ?? extensionPointProps.value ?? ''}}",
              "multilingual": "{{extensionPointProps.multilingual ?? false}}",
              "placeholder": "{{extensionPointProps.placeholder ?? ''}}",
              "readOnly": "{{_computed.isReadOnly ?? extensionPointProps.readOnly ?? false}}",
              "disabled": "{{extensionPointProps.disabled ?? false}}",
              "imageUpload": "{{_global.plugins['jwsoft-tiptap-editor']?.imageUpload ?? false}}",
              "dragDropImageUpload": "{{_global.plugins['jwsoft-tiptap-editor']?.dragDropImageUpload ?? true}}",
              "pasteImageUpload": "{{_global.plugins['jwsoft-tiptap-editor']?.pasteImageUpload ?? true}}",
              "mediaEmbed": "{{_global.plugins['jwsoft-tiptap-editor']?.mediaEmbed ?? false}}",
              "autoEmbedUrls": "{{_global.plugins['jwsoft-tiptap-editor']?.autoEmbedUrls ?? false}}",
              "youtubeEmbed": "{{_global.plugins['jwsoft-tiptap-editor']?.youtubeEmbed ?? true}}",
              "vimeoEmbed": "{{_global.plugins['jwsoft-tiptap-editor']?.vimeoEmbed ?? true}}",
              "mp4Embed": "{{_global.plugins['jwsoft-tiptap-editor']?.mp4Embed ?? true}}",
              "videoUpload": "{{_global.plugins['jwsoft-tiptap-editor']?.videoUpload ?? false}}",
              "videoMaxSizeMb": "{{_global.plugins['jwsoft-tiptap-editor']?.videoMaxSizeMb ?? 200}}",
              "externalMediaLoadMode": "{{_global.plugins['jwsoft-tiptap-editor']?.externalMediaLoadMode ?? 'immediate'}}",
              "mediaAutoplay": "{{_global.plugins['jwsoft-tiptap-editor']?.mediaAutoplay ?? false}}",
              "smartCards": "{{_global.plugins['jwsoft-tiptap-editor']?.smartCards ?? false}}",
              "autoSmartCards": "{{_global.plugins['jwsoft-tiptap-editor']?.autoSmartCards ?? false}}",
              "imageMaxSizeMb": "{{_global.plugins['jwsoft-tiptap-editor']?.imageMaxSizeMb ?? 2}}",
              "height": "{{extensionPointProps.height ?? _global.plugins['jwsoft-tiptap-editor']?.editorHeight ?? 400}}",
              "toolbar": "{{extensionPointProps.toolbar ?? _global.plugins['jwsoft-tiptap-editor']?.toolbar ?? 'standard'}}"
            }
          }
        ],
        "onUnmount": [
          {
            "handler": "jwsoft-tiptap-editor.destroyEditor",
            "params": {
              "name": "{{extensionPointProps.name ?? 'content'}}"
            }
          }
        ]
      }
    }
  ],
  "priority": 100
}
