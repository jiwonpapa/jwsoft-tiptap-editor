{
  "version": "1.0.0",
  "layout_name": "plugin_settings",
  "permissions": ["core.plugins.update"],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:jwsoft-tiptap-editor.settings.title",
    "description": "$t:jwsoft-tiptap-editor.settings.description"
  },
  "data_sources": [
    {
      "id": "settings",
      "label_key": "$t:jwsoft-tiptap-editor.editor.data_source.settings",
      "type": "api",
      "endpoint": "/api/admin/plugins/{{route.identifier}}/settings",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "initLocal": "form",
      "refetchOnMount": true
    }
  ],
  "slots": {
    "content": [
      {
        "id": "plugin_settings_content",
        "type": "basic",
        "name": "Div",
        "dataKey": "form",
        "trackChanges": true,
        "props": { "className": "admin-page-content-responsive" },
        "children": [
          {
            "id": "page_header",
            "type": "composite",
            "name": "PageHeader",
            "props": {
              "title": "$t:jwsoft-tiptap-editor.settings.title",
              "description": "$t:jwsoft-tiptap-editor.settings.description",
              "backPath": "/admin/plugins",
              "backLabel": "$t:admin.plugins.back_to_list"
            }
          },
          {
            "id": "legacy_warning",
            "type": "basic",
            "name": "Div",
            "props": { "className": "alert-warning" },
            "children": [
              {
                "type": "basic",
                "name": "P",
                "props": { "className": "text-warning-soft" },
                "text": "$t:jwsoft-tiptap-editor.settings.legacy_warning"
              },
              {
                "id": "field_legacy_acknowledgement",
                "type": "composite",
                "name": "Toggle",
                "props": { "name": "legacyContentRiskAcknowledged" }
              }
            ]
          },
          {
            "id": "validation_error",
            "type": "basic",
            "name": "Div",
            "if": "{{_local.errors}}",
            "props": { "className": "alert-danger mt-4" },
            "text": "$t:admin.plugins.settings.validation_error"
          },
          {
            "id": "section_editor",
            "type": "basic",
            "name": "Div",
            "props": { "className": "admin-card mt-6 space-y-6" },
            "children": [
              {
                "type": "basic",
                "name": "H3",
                "props": { "className": "text-lg font-semibold" },
                "text": "$t:jwsoft-tiptap-editor.settings.sections.editor"
              },
              {
                "id": "field_toolbar",
                "type": "basic",
                "name": "Div",
                "props": { "className": "section-heading-md" },
                "children": [
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "lg:col-span-1" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.toolbar.label"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "form-hint" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.toolbar.hint"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "lg:col-span-2" },
                    "children": [
                      {
                        "type": "composite",
                        "name": "Select",
                        "props": {
                          "name": "toolbar",
                          "className": "w-full",
                          "options": [
                            {
                              "value": "minimal",
                              "label": "$t:jwsoft-tiptap-editor.settings.fields.toolbar.minimal"
                            },
                            {
                              "value": "standard",
                              "label": "$t:jwsoft-tiptap-editor.settings.fields.toolbar.standard"
                            },
                            {
                              "value": "full",
                              "label": "$t:jwsoft-tiptap-editor.settings.fields.toolbar.full"
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "field_editor_height",
                "type": "basic",
                "name": "Div",
                "props": { "className": "section-heading-md" },
                "children": [
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "lg:col-span-1" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.editor_height.label"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "form-hint" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.editor_height.hint"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "lg:col-span-2" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Input",
                        "props": {
                          "type": "number",
                          "name": "editorHeight",
                          "min": 200,
                          "max": 2000,
                          "className": "input w-full"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
