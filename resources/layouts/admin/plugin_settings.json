                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "autoEmbedUrls" }
                      }
                    ]
                  },
                  {
                    "id": "field_youtube_embed",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.youtube_embed.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "youtubeEmbed" }
                      }
                    ]
                  },
                  {
                    "id": "field_vimeo_embed",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.vimeo_embed.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "vimeoEmbed" }
                      }
                    ]
                  },
                  {
                    "id": "field_mp4_embed",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.mp4_embed.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "mp4Embed" }
                      }
                    ]
                  },
                  {
                    "id": "field_video_upload",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.video_upload.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "videoUpload" }
                      }
                    ]
                  },
                  {
                    "id": "field_media_autoplay",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.media_autoplay.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "mediaAutoplay" }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "media_numbers",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "grid grid-cols-1 md:grid-cols-3 gap-4"
                },
                "children": [
                  {
                    "id": "field_video_max_size",
                    "type": "basic",
                    "name": "Div",
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.video_max_size.label"
                      },
                      {
                        "type": "basic",
                        "name": "Input",
                        "props": {
                          "type": "number",
                          "name": "videoMaxSizeMb",
                          "min": 1,
                          "max": 500,
                          "className": "input w-full"
                        }
                      }
                    ]
                  },
                  {
                    "id": "field_video_chunk_size",
                    "type": "basic",
                    "name": "Div",
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.video_chunk_size.label"
                      },
                      {
                        "type": "basic",
                        "name": "Input",
                        "props": {
                          "type": "number",
                          "name": "videoChunkSizeMb",
                          "min": 1,
                          "max": 10,
                          "className": "input w-full"
                        }
                      }
                    ]
                  },
                  {
                    "id": "field_external_media_load_mode",
                    "type": "basic",
                    "name": "Div",
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.external_media_load_mode.label"
                      },
                      {
                        "type": "composite",
                        "name": "Select",
                        "props": {
                          "name": "externalMediaLoadMode",
                          "className": "w-full",
                          "options": [
                            {
                              "value": "click",
                              "label": "$t:jwsoft-tiptap-editor.settings.fields.external_media_load_mode.click"
                            },
                            {
                              "value": "immediate",
                              "label": "$t:jwsoft-tiptap-editor.settings.fields.external_media_load_mode.immediate"
