          },
          {
            "id": "section_smart_cards",
            "type": "basic",
            "name": "Div",
            "props": { "className": "admin-card mt-4 space-y-6" },
            "children": [
              {
                "type": "basic",
                "name": "H3",
                "props": { "className": "text-lg font-semibold" },
                "text": "$t:jwsoft-tiptap-editor.settings.sections.smart_cards"
              },
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "grid grid-cols-1 md:grid-cols-2 gap-4"
                },
                "children": [
                  {
                    "id": "field_smart_cards",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.smart_cards.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "smartCards" }
                      }
                    ]
                  },
                  {
                    "id": "field_auto_smart_cards",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.auto_smart_cards.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "autoSmartCards" }
                      }
                    ]
                  },
                  {
                    "id": "field_social_cards",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.social_cards.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "socialCards" }
                      }
                    ]
                  },
                  {
                    "id": "field_generic_link_cards",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.generic_link_cards.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "genericLinkCards" }
                      }
                    ]
                  },
                  {
                    "id": "field_smart_card_images",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.smart_card_images.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "smartCardImages" }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "footer_buttons",
            "type": "basic",
            "name": "Div",
            "props": { "className": "sticky-footer-buttons" },
            "children": [
              {
                "id": "cancel_button",
                "type": "basic",
                "name": "Button",
                "props": { "type": "button", "className": "btn btn-secondary" },
                "text": "$t:common.cancel",
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": { "path": "/admin/plugins" }
                  }
                ]
              },
              {
                "id": "save_button",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "disabled": "{{!_local.hasChanges || _local.isSaving}}",
                  "className": "btn btn-primary"
                },
                "text": "$t:common.save",
                "actions": [
                  {
                    "type": "click",
                    "handler": "sequence",
                    "actions": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "isSaving": true,
                          "errors": null
                        }
                      },
                      {
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/admin/plugins/{{route.identifier}}/settings",
                        "params": {
                          "method": "PUT",
                          "body": "{{_local.form}}"
                        },
                        "onSuccess": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "isSaving": false,
                              "hasChanges": false
                            }
                          },
                          {
                            "handler": "setState",
                            "params": {
                              "target": "global",
                              "plugins": "{{Object.assign({}, _global.plugins ?? {}, { 'jwsoft-tiptap-editor': _local.form })}}"
                            }
                          },
                          {
                            "handler": "toast",
                            "params": {
                              "type": "success",
                              "message": "$t:admin.plugins.settings.save_success"
                            }
                          },
                          {
                            "handler": "refetchDataSource",
                            "params": { "dataSourceId": "settings" }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "isSaving": false,
                              "errors": "{{error.errors}}"
                            }
                          },
                          {
                            "handler": "toast",
                            "params": {
                              "type": "error",
                              "message": "{{error.message ?? '$t:admin.plugins.settings.save_error'}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
