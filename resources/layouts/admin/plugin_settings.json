                      {
                        "type": "composite",
                        "name": "Toggle",
                        "props": { "name": "pasteImageUpload" }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "field_image_max_size",
                "type": "basic",
                "name": "Div",
                "props": { "className": "section-heading-md" },
                "children": [
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "lg:col-span-1" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.image_max_size.label"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "form-hint" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.image_max_size.hint"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "lg:col-span-2" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Input",
                        "props": {
                          "type": "number",
                          "name": "imageMaxSizeMb",
                          "min": 1,
                          "max": 10,
                          "className": "input w-full"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "section_media",
            "type": "basic",
            "name": "Div",
            "props": { "className": "admin-card mt-4 space-y-6" },
            "children": [
              {
                "type": "basic",
                "name": "H3",
                "props": { "className": "text-lg font-semibold" },
                "text": "$t:jwsoft-tiptap-editor.settings.sections.media"
              },
              {
                "id": "media_privacy_notice",
                "type": "basic",
                "name": "P",
                "props": { "className": "alert-info" },
                "text": "$t:jwsoft-tiptap-editor.settings.media_privacy_notice"
              },
              {
                "id": "media_toggles",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "grid grid-cols-1 md:grid-cols-2 gap-4"
                },
                "children": [
                  {
                    "id": "field_media_embed",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "section-heading-md" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": { "className": "form-label" },
                        "text": "$t:jwsoft-tiptap-editor.settings.fields.media_embed.label"
                      },
                      {
                        "type": "composite",
                        "name": "Toggle",
