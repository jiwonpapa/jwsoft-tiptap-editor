{
  "$schema": "./editor-policy.schema.json",
  "policyVersion": "1.6.0",
  "externalEmbeds": {
    "x": {
      "hosts": [
        "x.com",
        "www.x.com",
        "twitter.com",
        "www.twitter.com",
        "mobile.twitter.com"
      ],
      "pathPattern": "^/(?:[A-Za-z0-9_]{1,15}/status|i/web/status)/([1-9][0-9]{0,24})/?$",
      "canonicalHost": "x.com",
      "sdkUrl": "https://platform.twitter.com/widgets.js",
      "scriptOrigins": ["https://platform.twitter.com"],
      "connectOrigins": [
        "https://cdn.syndication.twimg.com",
        "https://syndication.twitter.com"
      ],
      "frameOrigins": [
        "https://platform.twitter.com",
        "https://syndication.twitter.com"
      ],
      "imageOrigins": [
        "https://abs.twimg.com",
        "https://pbs.twimg.com",
        "https://platform.twitter.com"
      ]
    },
    "facebook": {
      "hosts": ["www.facebook.com", "facebook.com", "m.facebook.com"],
      "pathPattern": "^/([A-Za-z0-9.]+)/(posts|videos)/(?:[A-Za-z0-9_-]{1,600}/)?([1-9][0-9]{0,24}|pfbid[A-Za-z0-9]{10,200})/?$",
      "canonicalHost": "www.facebook.com",
      "sdkUrl": "https://connect.facebook.net/en_US/sdk.js#xfbml=0&version=v23.0",
      "scriptOrigins": ["https://connect.facebook.net"],
      "connectOrigins": ["https://www.facebook.com"],
      "frameOrigins": [
        "https://www.facebook.com",
        "https://staticxx.facebook.com"
      ],
      "imageOrigins": ["https://www.facebook.com"]
    }
  },
  "elements": {
    "p": { "attributes": ["class"] },
    "br": { "attributes": [] },
    "h2": { "attributes": ["class"] },
    "h3": { "attributes": ["class"] },
    "h4": { "attributes": ["class"] },
    "strong": { "attributes": [] },
    "em": { "attributes": [] },
    "u": { "attributes": [] },
    "s": { "attributes": [] },
    "span": { "attributes": ["class"] },
    "sub": { "attributes": [] },
    "sup": { "attributes": [] },
    "blockquote": { "attributes": ["class"] },
    "ul": { "attributes": ["class"] },
    "ol": { "attributes": ["class", "start"] },
    "li": { "attributes": ["class"] },
    "a": { "attributes": ["href", "title", "target", "rel", "class"] },
    "pre": { "attributes": ["class"] },
    "code": { "attributes": ["class"] },
    "hr": { "attributes": [] },
    "table": { "attributes": ["class"] },
    "thead": { "attributes": [] },
    "tbody": { "attributes": [] },
    "tr": { "attributes": [] },
    "th": { "attributes": ["colspan", "rowspan", "scope", "class"] },
    "td": { "attributes": ["colspan", "rowspan", "class"] },
    "img": {
      "attributes": [
        "src",
        "alt",
        "title",
        "width",
        "height",
        "loading",
        "class"
      ]
    },
    "figure": { "attributes": ["class"] },
    "figcaption": { "attributes": [] }
  },
  "globalAttributes": ["lang", "dir"],
  "classTokens": {
    "textSize": ["jw-text-sm", "jw-text-base", "jw-text-lg", "jw-text-xl"],
    "alignment": [
      "jw-align-left",
      "jw-align-center",
      "jw-align-right",
      "jw-align-justify"
    ],
    "inlineSize": [
      "jw-font-12",
      "jw-font-14",
      "jw-font-16",
      "jw-font-18",
      "jw-font-20",
      "jw-font-24",
      "jw-font-28",
      "jw-font-32"
    ],
    "textColor": [
      "jw-color-gray",
      "jw-color-red",
      "jw-color-orange",
      "jw-color-green",
      "jw-color-blue",
      "jw-color-purple"
    ],
    "highlight": [
      "jw-highlight-yellow",
      "jw-highlight-green",
      "jw-highlight-blue",
      "jw-highlight-pink",
      "jw-highlight-purple"
    ],
    "task": ["jw-task-list", "jw-task-item", "jw-task-checked"],
    "cellBackground": [
      "jw-cell-gray",
      "jw-cell-blue",
      "jw-cell-green",
      "jw-cell-yellow",
      "jw-cell-pink"
    ],
    "cellVertical": ["jw-cell-top", "jw-cell-middle", "jw-cell-bottom"],
    "tableBorder": ["jw-table-bordered", "jw-table-borderless"],
    "indentation": ["jw-indent-1", "jw-indent-2", "jw-indent-3", "jw-indent-4"],
    "spacing": ["jw-space-tight", "jw-space-normal", "jw-space-relaxed"],
    "table": ["jw-table", "jw-table-striped"],
    "image": [
      "jw-image",
      "jw-image-align-left",
      "jw-image-align-center",
      "jw-image-align-right",
      "jw-image-size-25",
      "jw-image-size-10",
      "jw-image-size-15",
      "jw-image-size-20",
      "jw-image-size-30",
      "jw-image-size-35",
      "jw-image-size-40",
      "jw-image-size-45",
      "jw-image-size-50",
      "jw-image-size-55",
      "jw-image-size-60",
      "jw-image-size-65",
      "jw-image-size-70",
      "jw-image-size-75",
      "jw-image-size-80",
      "jw-image-size-85",
      "jw-image-size-90",
      "jw-image-size-95",
      "jw-image-size-100",
      "jw-image-inline",
      "jw-image-block",
      "jw-image-rounded"
    ],
    "media": [
      "jw-media",
      "jw-media-16x9",
      "jw-media-9x16",
      "jw-media-youtube",
      "jw-media-vimeo",
      "jw-media-mp4",
      "jw-media-source"
    ],
    "card": [
      "jw-card",
      "jw-card-generic",
      "jw-card-instagram",
      "jw-card-x",
      "jw-card-tiktok",
      "jw-card-facebook",
      "jw-card-threads",
      "jw-card-link",
      "jw-card-image"
    ]
  },
  "urls": {
    "linkSchemes": ["https", "mailto", "tel"],
    "allowRelativeLinks": true,
    "allowedLinkHosts": []
  },
  "media": {
    "schemes": ["https"],
    "allowRelative": true,
    "allowedHosts": [],
    "allowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "image/avif"
    ]
  },
  "limits": {
    "maxHtmlBytes": 1048576,
    "maxTextCharacters": 500000,
    "maxImageBytes": 10485760,
    "maxImagePixels": 40000000,
    "maxTableCells": 10000
  }
}
