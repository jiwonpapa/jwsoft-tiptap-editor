{
  "name": "@jwsoft/tiptap-editor",
  "version": "0.1.5",
  "description": "jw-editor: rich-text and media editor for Gnuboard 7",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0 <27",
    "npm": ">=10"
  },
  "scripts": {
    "build": "vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run validate && npm run test:unit",
    "lint": "eslint resources/js tests scripts *.config.ts --max-warnings=0",
    "generate": "node scripts/generate-policy.mjs && node scripts/generate-third-party-notices.mjs",
    "generate:check": "node scripts/generate-policy.mjs --check",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "generate:notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run generate:check && npm run generate:notices:check && npm run validate:manifest && npm run validate:policy && npm run validate:docs && npm run validate:contracts && npm run validate:github-source",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "validate:policy": "node scripts/validate-policy.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "validate:github-source": "node scripts/validate-github-source.mjs",
    "test:unit": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=test-results/parity/unit.json",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e:ui": "npm run build",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-text-align": "3.30.5",
    "@tiptap/extension-underline": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "dompurify": "3.4.14",
    "lucide": "1.37.0",
    "social-media-parser": "0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
