# 복사본 staging.env는 커밋하지 않습니다.
DEPLOY_HOST=gnuboard7-staging
# SSH 사용자와 앱 소유자가 다를 때만 지정합니다. sudo -n -u 권한이 필요합니다.
DEPLOY_RUN_USER=
DEPLOY_MODE=install
# 배포 역할(staging)과 Laravel 실행 모드는 별개입니다. 원격의 실제 값을 명시합니다.
EXPECTED_APP_ENV=staging
G7_REMOTE_ROOT=/var/www/gnuboard7
PHP_BIN=php
REMOTE_ARTIFACT_DIR=/tmp/jwsoft-tiptap-editor
SMOKE_URL=https://staging.example.com/
