# 복사본 production.env는 커밋하지 않습니다.
DEPLOY_HOST=gnuboard7-production
DEPLOY_RUN_USER=
DEPLOY_MODE=update
EXPECTED_APP_ENV=production
G7_REMOTE_ROOT=/var/www/gnuboard7
PHP_BIN=php
REMOTE_ARTIFACT_DIR=/tmp/jwsoft-tiptap-editor
SMOKE_URL=https://www.example.com/
# staging에서 동일 artifact가 통과한 뒤 실제 SHA-256으로 교체합니다.
APPROVED_STAGING_SHA256=replace-with-staging-sha256
